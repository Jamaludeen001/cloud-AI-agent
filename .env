# ── Runtime ──
APP_ENV=dev
LOG_LEVEL=INFO

# ── LLM provider: "google" or "openai" ──
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=AQ.Ab8RN6Kh2qMU_0avMl7ONGCjoKfCsJEhTERtnSA63QJg2bBxGw
QDRANT_URL=https://25d6c9f4-26ad-41d0-a1d0-b18ccfa07d8e.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NmJlY2VhM2YtNGJkMS00ZDZkLWIxYjUtZTM3NTcyN2ExZjk0In0.wCQCN7z9JXJwtXu9qMQPT9bVsgk4v2echwDfhghv4G4

# Uncomment and set only if you switch LLM_PROVIDER to "openai":
# OPENAI_API_KEY=sk-...

# ── Budgets ──
MAX_LLM_CALLS=4
MAX_TOKENS=8000
MAX_SECONDS=30

# ── State (leave empty to use in-memory) ──
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ── Retrieval ──
TOP_K_RETRIEVE=10
TOP_K_RERANK=5
RERANK_THRESHOLD=200

# ── Fetching ──
DEFAULT_TIMEOUT=30
MAX_BYTES=5000000

# ── Observability (optional) ──
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-app